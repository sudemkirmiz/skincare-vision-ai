# SkinCare Vision AI configuration
# Copy to .env and fill in the key of the provider you want to use. Every key is optional:
# without one, analysis, scores, routine and a rule-based comment still work.
# Full reference: docs/configuration.md

# --- AI providers and keys ---
# Gemini | OpenAI | Hugging Face | Groq
VLM_PROVIDER=Gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# --- Model names (change here, without touching code, when a provider retires a model) ---
GEMINI_MODEL=gemini-3.8-flash
# Tried with the same key on quota or server errors (quotas are per model)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Lowest-priced current OpenAI model with image input (Responses API)
OPENAI_MODEL=gpt-6-luna
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
HF_VLM_MODEL=google/gemma-3-4b-it
HF_PROVIDER=auto

# --- Provider network settings ---
VLM_TIMEOUT_SECONDS=90
VLM_MAX_RETRIES=2
# Set to true behind a corporate proxy (by default the system proxy is ignored)
VLM_TRUST_ENV_PROXY=false
# If the chosen provider fails, try the others that have a key, in this order
VLM_FALLBACK=true
VLM_FALLBACK_ORDER=Gemini,OpenAI,Groq,Hugging Face
# Gemini re-checks the spots (+1 Gemini call per single-photo analysis)
VLM_SECOND_OPINION=true

# --- YOLO ---
YOLO_MODEL_PATH=models/acne_like_spot.pt
YOLO_CONFIDENCE=0.10
YOLO_IMAGE_SIZE=640

# --- Face landmarks (MediaPipe). Falls back to OpenCV Haar when the file is missing ---
FACE_LANDMARKER_PATH=models/face_landmarker.task

# --- Product catalog (editable JSON; schema example: data/products.example.json) ---
PRODUCT_CATALOG_PATH=data/products.json

# --- History and tracking (local SQLite: results and a small face preview) ---
HISTORY_ENABLED=true
HISTORY_DB_PATH=data/history.db

# --- Application ---
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
# Total limit for multipart/JSON requests; also enforced for chunked requests
MAX_REQUEST_BODY_MB=32
# Hourly limits for expensive work, per client IP and action
ANALYSIS_RATE_LIMIT=12
LABEL_RATE_LIMIT=30
CAPTURE_RATE_LIMIT=600
# Let users type their own provider key (never stored on the server, only relayed per request).
# Unset: true locally, false when PUBLIC_DEPLOYMENT=true.
# ALLOW_USER_API_KEYS=true
# device: each browser sees only the profiles it created (sharing one link with friends).
# shared: every profile is visible (a personal install). Unset: shared locally, device in public mode.
# PROFILE_SCOPE=shared
# Set to true before exposing the app to a network; it then refuses to start without the settings below.
PUBLIC_DEPLOYMENT=false
# At least 32 random characters. The interface asks for it once and keeps it in tab memory.
APP_ACCESS_TOKEN=
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from another address (e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173
# Accepted Host headers. List your real domain explicitly; no wildcards.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
