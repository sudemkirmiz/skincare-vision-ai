# SkinCare Vision AI configuration
# Bu dosyayı .env olarak kopyala ve kullanacağın sağlayıcının anahtarını doldur.

# --- VLM sağlayıcı ve anahtarlar ---
# Gemini | Hugging Face | Groq
VLM_PROVIDER=Gemini
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# --- Model adları (sağlayıcı bir modeli kaldırırsa koda dokunmadan değiştir) ---
GEMINI_MODEL=gemini-3.5-flash
# Kota/hata durumunda aynı anahtarla denenecek modeller (kota model başınadır)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
HF_VLM_MODEL=google/gemma-3-4b-it
HF_PROVIDER=auto

# --- VLM ağ ayarları ---
VLM_TIMEOUT_SECONDS=90
VLM_MAX_RETRIES=2
# Kurumsal proxy arkasındaysan true yap (varsayılan: sistem proxy'si yok sayılır)
VLM_TRUST_ENV_PROXY=false
# Seçili sağlayıcı hata verirse anahtarı olan diğerlerini bu sırayla dene
VLM_FALLBACK=true
# Gemini noktaları ikinci kez kontrol eder (tek fotoğraflı analizde +1 Gemini çağrısı)
VLM_SECOND_OPINION=true
VLM_FALLBACK_ORDER=Gemini,Groq,Hugging Face

# --- YOLO ---
YOLO_MODEL_PATH=models/acne_like_spot.pt
YOLO_CONFIDENCE=0.10
YOLO_IMAGE_SIZE=640

# --- Yüz haritası (MediaPipe). Dosya yoksa OpenCV Haar kullanılır ---
FACE_LANDMARKER_PATH=models/face_landmarker.task

# --- Ürün kataloğu (düzenlenebilir JSON; örnek: data/products.example.json) ---
PRODUCT_CATALOG_PATH=data/products.json

# --- Geçmiş/takip (yerel SQLite; sonuçlar + küçük yüz önizlemesi) ---
# Herkese açık yayında false yap: kullanıcı hesabı olmadan kayıtlar herkese görünür
HISTORY_ENABLED=true
HISTORY_DB_PATH=data/history.db

# --- Uygulama ---
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
# Multipart/JSON isteklerinin toplam üst sınırı; chunked isteklerde de uygulanır
MAX_REQUEST_BODY_MB=32
# Saatlik pahalı işlem sınırları (istemci IP'si ve işlem türü başına)
ANALYSIS_RATE_LIMIT=12
LABEL_RATE_LIMIT=30
CAPTURE_RATE_LIMIT=600
# Herkese açık yayında false yap: ziyaretçiler kendi anahtarını giremez, sadece sunucu anahtarı kullanılır
ALLOW_USER_API_KEYS=true
# İnternete/LAN'a açarken true yap. Uygulama, aşağıdaki güvenlik ayarları olmadan başlamayı reddeder.
PUBLIC_DEPLOYMENT=false
# En az 32 rastgele karakter önerilir. Arayüz ilk açılışta bunu sorar ve yalnızca sekme belleğinde tutar.
APP_ACCESS_TOKEN=
LOG_LEVEL=INFO
# React arayüzü ayrı bir adresten (ör. Vite geliştirme sunucusu) API'ye erişecekse, virgülle ayırın
CORS_ORIGINS=http://localhost:5173
# Host başlığı doğrulaması. Canlı alan adınızı açıkça ekleyin; joker karakter kullanmayın.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
