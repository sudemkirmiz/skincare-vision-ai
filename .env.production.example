# Copy to .env.production and fill in the empty values. Never commit the real file.
# Full reference: docs/configuration.md · deployment checklist: docs/deployment.md
ENV_FILE=.env.production
APP_PORT=8000

# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
PUBLIC_DEPLOYMENT=true
# Keys typed by visitors stay off in production; the compose overlay enforces it.
ALLOW_USER_API_KEYS=false
# Each browser sees only the profiles it created.
PROFILE_SCOPE=device

# The real host name / origin your reverse proxy serves.
ALLOWED_HOSTS=skin.example.com
CORS_ORIGINS=https://skin.example.com

# Optional: at least one provider key enables the AI-written comment, label reading and the coach.
VLM_PROVIDER=Gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

VLM_FALLBACK=true
VLM_SECOND_OPINION=true
VLM_TRUST_ENV_PROXY=false
HISTORY_ENABLED=true
LOG_LEVEL=INFO

MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
MAX_REQUEST_BODY_MB=32
ANALYSIS_RATE_LIMIT=12
LABEL_RATE_LIMIT=30
CAPTURE_RATE_LIMIT=600
