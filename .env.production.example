# Bu dosyayı .env.production olarak kopyalayın ve boş değerleri doldurun.
# Gerçek dosyayı Git'e eklemeyin.
ENV_FILE=.env.production
APP_PORT=8000

# En az 32 rastgele karakter: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
PUBLIC_DEPLOYMENT=true
ALLOW_USER_API_KEYS=false

# Reverse proxy'nin kullanıcıya sunduğu gerçek alan adı/origin.
ALLOWED_HOSTS=cilt.example.com
CORS_ORIGINS=https://cilt.example.com

# En az bir sağlayıcı anahtarı isteğe bağlı AI özellikleri için gereklidir.
VLM_PROVIDER=Gemini
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

VLM_FALLBACK=true
VLM_SECOND_OPINION=true
VLM_TRUST_ENV_PROXY=false
HISTORY_ENABLED=true
LOG_LEVEL=INFO

MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
MAX_REQUEST_BODY_MB=32
ANALYSIS_RATE_LIMIT=12
LABEL_RATE_LIMIT=30
CAPTURE_RATE_LIMIT=600
